  },
  "Jwt": {
    "SecretKey": "VideoCallSecretKey123456789012345678901234567890",
    "Issuer": "VideoCallAPI",
    "Audience": "VideoCallClient",
    "ExpirationInDays": 7
  },
  "QQ": {

# Copy to .env.production or configure the same keys in GitHub Secrets / server environment.
# Do not commit real values.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:7001

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=foreverlove_chat;Username=postgres;Password=change-me
Jwt__SecretKey=change-me-to-a-long-random-secret

QQ__ClientId=your-qq-connect-app-id
QQ__ClientSecret=your-qq-connect-app-key
QQ__RedirectUri=https://chat.wangbank.top/qq-callback
QQ__AllowMockLogin=false

Admin__Emails__0=1224327326@qq.com

VITE_API_BASE_URL=https://chat.wangbank.top
VITE_SIGNALR_HUB_URL=https://chat.wangbank.top/videocallhub
VITE_ADMIN_EMAILS=1224327326@qq.com

# The API signs short-lived LiveKit room tokens. These must match the key pair
# provided to the livekit service and remain in deployment secrets.
LiveKit__Url=wss://media.example.com
LiveKit__ApiKey=replace-with-a-livekit-api-key
LiveKit__ApiSecret=replace-with-at-least-32-random-characters
LiveKit__RoomPrefix=call-
LiveKit__TokenTtlMinutes=30

# Docker Compose environment equivalents when self-hosting LiveKit.
LIVEKIT_PUBLIC_URL=wss://media.example.com
LIVEKIT_API_KEY=replace-with-a-livekit-api-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_NODE_IP=YOUR_PUBLIC_IPV4
LIVEKIT_USE_EXTERNAL_IP=false
LIVEKIT_PORT=7880
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_PORT_MIN=50000
LIVEKIT_RTC_PORT_MAX=50100
LIVEKIT_BIND_HOST=0.0.0.0

# Copy to .env.production or configure the same keys in GitHub Secrets / server environment.
# Do not commit real values.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:7001

ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=foreverlove_chat;Username=postgres;Password=change-me
Jwt__SecretKey=change-me-to-a-long-random-secret

QQ__ClientId=your-qq-connect-app-id
QQ__ClientSecret=your-qq-connect-app-key
QQ__RedirectUri=https://chat.wangbank.top/qq-callback
QQ__AllowMockLogin=false

Admin__Emails__0=1224327326@qq.com

VITE_API_BASE_URL=https://chat.wangbank.top
VITE_SIGNALR_HUB_URL=https://chat.wangbank.top/videocallhub
VITE_ADMIN_EMAILS=1224327326@qq.com

# Browser/mobile callers retrieve these values from /api/system/webrtc-config.
# Supply a publicly reachable TURN server and do not commit real credentials.
WEBRTC_TURN_URL=turn:YOUR_TURN_HOST:3478?transport=udp
WEBRTC_TURN_USERNAME=change-this-turn-username
WEBRTC_TURN_CREDENTIAL=change-this-turn-credential

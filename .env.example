# Example values for local Docker deployments. scripts/deploy-local.ps1 creates
# %USERPROFILE%\.foreverlove-chat\foreverlove-chat.env with generated secrets
# on first run. Set FOREVERLOVE_CHAT_ENV_FILE to use a different path.

APP_VERSION=1.0.0-local
IMAGE_TAG=local
VCS_REF=local

API_ENVIRONMENT=Production
API_PORT=17101
API_BIND_HOST=0.0.0.0
API_LOGS_DIR=C:\Users\YOUR_USER\.foreverlove-chat\storage\logs
API_AVATAR_DIR=C:\Users\YOUR_USER\.foreverlove-chat\storage\avatar
API_CHAT_FILES_DIR=C:\Users\YOUR_USER\.foreverlove-chat\storage\chat-files
API_PUBLIC_URL=http://YOUR_LAN_OR_PUBLIC_IP:17101

WEB_PORT=17102
WEB_BIND_HOST=0.0.0.0
WEB_PUBLIC_URL=http://YOUR_LAN_OR_PUBLIC_IP:17102
API_PROXY_TARGET=http://api:17101
SIGNALR_PUBLIC_URL=http://YOUR_LAN_OR_PUBLIC_IP:17101/videocallhub

# LiveKit owns the media plane. The public URL must be reachable by web and
# mobile clients (wss:// is required when the web app is served over HTTPS).
LIVEKIT_PUBLIC_URL=ws://YOUR_LAN_OR_PUBLIC_IP:17880
LIVEKIT_API_KEY=replace-with-a-livekit-api-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_ROOM_PREFIX=call-
LIVEKIT_TOKEN_TTL_MINUTES=30
LIVEKIT_PORT=17880
LIVEKIT_RTC_TCP_PORT=17881
LIVEKIT_RTC_PORT_MIN=50000
LIVEKIT_RTC_PORT_MAX=50100
# Keep the media ports reachable from remote clients. Do not bind this to
# 127.0.0.1 on a public host.
LIVEKIT_BIND_HOST=0.0.0.0
# Set this to the server public IPv4 for a NAT/cloud host, or use automatic
# STUN discovery by setting LIVEKIT_USE_EXTERNAL_IP=true.
LIVEKIT_NODE_IP=YOUR_PUBLIC_IPV4
LIVEKIT_USE_EXTERNAL_IP=false

POSTGRES_DB=foreverlove_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_PORT=17132
POSTGRES_BIND_HOST=127.0.0.1

JWT_SECRET=change-this-to-at-least-32-random-characters
JWT_ISSUER=VideoCallAPI
JWT_AUDIENCE=VideoCallClient

QQ__ClientId=your-qq-app-id
QQ__ClientSecret=your-qq-app-key
QQ__RedirectUri=https://chat.wangbank.top/qq-callback
QQ__AllowMockLogin=false

ADMIN_EMAILS=1224327326@qq.com
VITE_ADMIN_EMAILS=1224327326@qq.com

Email__SmtpHost=smtp.qq.com
Email__SmtpPort=587
Email__EnableSsl=true
Email__Username=1224327326@qq.com
Email__Password=your-qq-mail-authorization-code
Email__FromEmail=1224327326@qq.com
Email__FromName=Forever Love
Email__PasswordResetBaseUrl=https://chat.wangbank.top/reset-password
Email__PasswordResetTokenMinutes=30

SWAGGER_ENABLED=false
USE_HTTPS_REDIRECTION=false
EXTRA_CORS_ORIGIN=https://chat.wangbank.top
